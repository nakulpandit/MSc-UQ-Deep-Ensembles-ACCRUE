





import random
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import torch

SEED = 42

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

device = torch.device(
    'mps' if torch.backends.mps.is_available()
    else 'cuda' if torch.cuda.is_available()
    else 'cpu'
)

print(f'PyTorch version: {torch.__version__}')
print(f'Device: {device}')



















